{
  "name": "@pook/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "contract",
    "sdk"
  ],
  "scripts": {
    "build:contract": "npm run build --workspace=@pook/contract",
    "build:sdk": "npm run build --workspace=@pook/sdk",
    "build": "npm run build:contract && npm run build:sdk",
    "typecheck": "tsc -p contract/tsconfig.json --noEmit && tsc -p sdk/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@pook/contract": "0.1.2",
    "@pook/sdk": "0.1.2",
    "@solana/kit": "^8.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
